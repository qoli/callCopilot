# Copy to ../.env and fill in local secrets.

# Local oMLX provider
CALLCOPILOT_OMLX_SERVER_ROOT=http://127.0.0.1:8001
CALLCOPILOT_OMLX_API_KEY=change-me
CALLCOPILOT_DEFAULT_MODEL=Qwen3.6-35B-A3B-bf16

# DeepSeek official Anthropic API
DEEPSEEK_API_KEY=
CALLCOPILOT_DEEPSEEK_PROVIDER_BASE_URL=https://api.deepseek.com/anthropic

# NVIDIA hosted DeepSeek OpenAI-compatible API
NVIDIA_DEEPSEEK_API_KEY=
CALLCOPILOT_NVIDIA_DEEPSEEK_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
